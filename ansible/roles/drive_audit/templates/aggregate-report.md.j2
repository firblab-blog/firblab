## Cross-host risk flags

{% set flagged = namespace(items=[]) %}
{% for h in audited_hosts %}
{% for d in h.block_devices %}
{%- set s = d.smart | default({}) -%}
{%- set n = d.nvme_smart | default({}) -%}
{%- set us = n.get('unsafe_shutdowns') if n else (s.nvme_smart_health_information_log.unsafe_shutdowns if s.nvme_smart_health_information_log is defined else 0) | int -%}
{%- set pc = n.get('power_cycles') if n else (s.nvme_smart_health_information_log.power_cycles if s.nvme_smart_health_information_log is defined else 0) | int -%}
{%- set pu = n.get('percentage_used') if n else (s.nvme_smart_health_information_log.percentage_used if s.nvme_smart_health_information_log is defined else 0) | int -%}
{%- set me = n.get('media_errors') if n else (s.nvme_smart_health_information_log.media_errors if s.nvme_smart_health_information_log is defined else 0) | int -%}
{%- if pc and pc > 0 and us and (us | int / pc | int) > 0.10 -%}
  {%- set _ = flagged.items.append((h.meta.hostname, d.name, 'High unsafe-shutdown ratio: ' ~ us ~ '/' ~ pc ~ ' (' ~ ((us | int / pc | int) * 100) | round(0) | int ~ '%) — PLP / power-stability concern')) -%}
{%- endif -%}
{%- if pu and pu | int >= 80 -%}
  {%- set _ = flagged.items.append((h.meta.hostname, d.name, 'High wear: ' ~ pu ~ '% used')) -%}
{%- endif -%}
{%- if me and me | int > 0 -%}
  {%- set _ = flagged.items.append((h.meta.hostname, d.name, '⚠️ Media errors: ' ~ me)) -%}
{%- endif -%}
{# SATA reallocated sectors #}
{%- if d.get('transport', '') != 'nvme' and s.ata_smart_attributes is defined -%}
  {%- for a in s.ata_smart_attributes.table | default([]) -%}
    {%- if a.name == 'Reallocated_Sector_Ct' and (a.raw.value | int) > 0 -%}
      {%- set _ = flagged.items.append((h.meta.hostname, d.name, '⚠️ Reallocated sectors: ' ~ a.raw.value)) -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{% endfor %}
{# Host config flags #}
{%- if h.host_config.lvm_issue_discards is defined and h.host_config.lvm_issue_discards in ['0', 'default'] -%}
  {%- set _ = flagged.items.append((h.meta.hostname, '(host)', 'LVM `issue_discards` not set to 1 — TRIM may not reach physical SSD/NVMe')) -%}
{%- endif -%}
{%- set sm = h.host_config.systemd_units | default({}) -%}
{%- if sm.get('smartd.service', '') not in ['enabled/active', 'static/active'] and (sm.get('smartmontools.service', '') not in ['enabled/active', 'static/active']) and h.host_config.platform | default('') not in ['macos', 'truenas'] -%}
  {%- set _ = flagged.items.append((h.meta.hostname, '(host)', 'smartd is not running — no proactive SMART monitoring')) -%}
{%- endif -%}
{%- set mt = h.host_config.tools_present | default({}) | dict2items | selectattr('value', 'equalto', 'missing') | map(attribute='key') | list -%}
{%- if mt and 'smartctl' in mt -%}
  {%- set _ = flagged.items.append((h.meta.hostname, '(host)', 'smartctl not installed — drive health is invisible')) -%}
{%- endif -%}
{% endfor %}

{% if flagged.items | length == 0 %}
✅ No risk flags raised.
