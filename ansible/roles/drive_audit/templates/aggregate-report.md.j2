## Every physical drive in the lab

| Host | Device | Size | Model | Serial | Transport | HDD? | Health | Wear / TBW | Notes |
|------|--------|------|-------|--------|-----------|------|--------|------------|-------|
{% for h in audited_hosts %}
{% for d in h.block_devices %}
{%- set s = d.smart | default({}) -%}
{%- set n = d.nvme_smart | default({}) -%}
{%- set health = 'PASSED' if (s.smart_status.passed | default(false)) else ('FAILED' if s.smart_status is defined and s.smart_status.passed is sameas false else '?') -%}
{%- set pu = n.get('percentage_used') if n else (s.nvme_smart_health_information_log.percentage_used if s.nvme_smart_health_information_log is defined else none) -%}
{%- set dw = n.get('data_units_written') if n else (s.nvme_smart_health_information_log.data_units_written if s.nvme_smart_health_information_log is defined else none) -%}
{%- set us = n.get('unsafe_shutdowns') if n else (s.nvme_smart_health_information_log.unsafe_shutdowns if s.nvme_smart_health_information_log is defined else none) -%}
{%- set pc = n.get('power_cycles') if n else (s.nvme_smart_health_information_log.power_cycles if s.nvme_smart_health_information_log is defined else none) -%}
{%- set poh = s.power_on_time.hours if s.power_on_time is defined else (n.get('power_on_hours') if n else none) -%}
{%- set ratio = ((us | int / pc | int) * 100) | round(0) if us is not none and pc is not none and pc | int > 0 else none -%}
{%- set notes_parts = [] -%}
{%- if poh is not none -%}{%- set _ = notes_parts.append(poh ~ ' hrs') -%}{%- endif -%}
{%- if dw is not none -%}{%- set _ = notes_parts.append(((dw * 512000 / (1024**4)) | round(1)) | string ~ ' TB W') -%}{%- endif -%}
{%- if us is not none and ratio is not none -%}{%- set _ = notes_parts.append('unsafe shutdowns: ' ~ us ~ ' (' ~ ratio | int ~ '% of cycles)') -%}{%- endif -%}
{# SATA: pull Total_LBAs_Written from ATA attributes #}
{%- if d.get('transport', '') != 'nvme' and s.ata_smart_attributes is defined -%}
  {%- for a in s.ata_smart_attributes.table | default([]) -%}
    {%- if a.name == 'Total_LBAs_Written' and a.raw.value is defined -%}
      {%- set _ = notes_parts.append(((a.raw.value * 512 / (1024**4)) | round(1)) | string ~ ' TB W') -%}
    {%- elif a.name == 'Wear_Leveling_Count' -%}
      {%- set _ = notes_parts.append('wear-norm ' ~ a.value | default('?')) -%}
    {%- elif a.name == 'Reallocated_Sector_Ct' and (a.raw.value | int) > 0 -%}
      {%- set _ = notes_parts.append('⚠️ ' ~ a.raw.value ~ ' reallocated sectors') -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
| {{ h.meta.hostname }} | `{{ d.path | default('/dev/' ~ d.get('name', '?')) }}` | {{ d.get('size_human', '?') }} | {{ d.get('model', '?') | truncate(28, true, '…') }} | `{{ d.get('serial', '') | truncate(20, true, '…') }}` | {{ d.get('transport', '?') }} | {{ 'Y' if d.get('rotational', false) else 'N' }} | {{ health }} | {% if pu is not none %}{{ pu }}% used{% endif %} | {{ notes_parts | join(' · ') }} |
{% endfor %}
{% endfor %}

